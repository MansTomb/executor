---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import { releaseCommands, type ReleaseCommandProduct } from "../release-commands.ts";
interface Props { product: typeof ReleaseCommandProduct.Type }
const { description, command } = releaseCommands[Astro.props.product];
---
<p>{description}</p>
<CodeBlock code={command} lang="bash" title="Bash" />
